# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Để trống thì tự suy ra theo model: bge-m3=1024, text-embedding-3-small=1536,
# gemini-embedding-001=3072. Đổi model thì phải xoá chroma_db/ rồi index lại.
EMBEDDING_DIM=

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=0.50
